# Server Configuration
PORT=5001
NODE_ENV=development

# MySQL Database (Separate from Simple ADVT - use 'matrimony_db')
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_db_password
DB_NAME=matrimony_db

# Email / SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_smtp_app_password
FROM_EMAIL="Matrimonyer" <your_email@gmail.com>

# Security & Authentication (Generate a 64-char random string in production)
JWT_SECRET=your_secure_random_64_char_jwt_secret_here


# OTP Settings
OTP_EXPIRY_MINUTES=5
RATE_LIMIT_MAX_ATTEMPTS=3
RATE_LIMIT_WINDOW_MINUTES=10

# Test OTP (set to true in dev/test only - never in production)
ENABLE_TEST_OTP=true
TEST_OTP_ALLOWLIST=plestarinc@gmail.com,test@test.com

# Upload limits
MAX_IMAGE_SIZE_MB=5
